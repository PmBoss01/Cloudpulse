DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (used in prod settings; dev defaults to sqlite)
DATABASE_URL=postgres://cloudpulse:cloudpulse@localhost:5432/cloudpulse

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend origin allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Used to build links in emails (e.g. password reset)
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=CloudPulse <noreply@cloudpulse.local>

# Email delivery (prod only — dev prints emails to the console instead).
# Prefer port 465 + EMAIL_USE_SSL=true (implicit SSL) over 587 + EMAIL_USE_TLS
# (STARTTLS) — some networks/firewalls silently drop the STARTTLS handshake.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true

# Google OAuth (console.cloud.google.com) — redirect URI must be
# http://localhost:8000/api/auth/google/callback/ in dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (github.com/settings/developers) — callback URL must be
# http://localhost:8000/api/auth/github/callback/ in dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Azure provider credentials (service principal)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
