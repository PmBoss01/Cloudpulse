DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (used in prod settings; dev defaults to sqlite)
DATABASE_URL=postgres://cloudpulse:cloudpulse@localhost:5432/cloudpulse

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend origin allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Azure provider credentials (service principal)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
